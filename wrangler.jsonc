{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earned",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/mcp", "/paypal/*", "/webhooks/*", "/media/*", "/orders/*", "/receipts/*", "/.well-known/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "earned", "database_id": "d4ce54a4-a170-41eb-b07b-c75773d68e7a", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "earned-media" }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "PAYPAL_API_BASE": "https://api-m.sandbox.paypal.com",
    "AI_API_BASE": "https://api.apimart.ai",
    "SPEND_CAP_USD": "15",
    "DAILY_ORDER_CAP": "80",
    "DAILY_SPEND_CAP_USD": "1.2",
    "VISITOR_DAILY_ORDERS": "3",
    "VISITOR_DAILY_CHAT": "40"
  }
  // Secrets (wrangler secret put): PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET, PAYPAL_WEBHOOK_ID,
  // AI_API_KEY, RECEIPT_SIGNING_JWK, IP_HASH_SALT
}
